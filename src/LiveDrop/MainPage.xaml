<Page
    x:Class="LiveDrop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid Padding="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Uid="HeaderTitle" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button x:Name="MoreButton" Grid.Column="1" Width="44" Height="44" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" x:Uid="MoreButton" Click="OnMoreClicked">
        <SymbolIcon Symbol="More" />
      </Button>
    </Grid>
    <ScrollViewer Grid.Row="2" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock x:Uid="SupportedPeers" FontSize="20" Margin="0,0,0,8" />
        <CheckBox x:Name="NearbyCheckBox" x:Uid="NearbyProtocol" IsChecked="False" />
        <CheckBox x:Name="QuickShareCheckBox" x:Uid="QuickShareProtocol" IsChecked="True" />
        <TextBlock x:Uid="DiscoveryHeading" FontSize="20" Margin="0,24,0,8" />
        <ListView x:Name="PeersList" MinHeight="120" SelectionChanged="OnPeerSelectionChanged">
          <ListView.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding DisplayText}" /></DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="SelectedFileText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBlock x:Name="IncomingDetailsText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,12,0,0" />
        <Grid x:Name="TransferProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ProgressBar x:Name="TransferProgressBar" Grid.Column="0" Height="6" Minimum="0" Maximum="1" VerticalAlignment="Center" />
          <TextBlock x:Name="TransferProgressText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="ReceiveCompleteText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,16,0,0" />
        <StackPanel x:Name="IncomingDecisionPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
          <Button x:Name="AcceptIncomingButton" x:Uid="AcceptIncomingButton" Click="OnAcceptIncomingClicked" />
          <Button x:Name="DenyIncomingButton" x:Uid="DenyIncomingButton" Margin="8,0,0,0" Click="OnDenyIncomingClicked" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="ShareButton" x:Uid="SelectFilesButton" Click="OnShareClicked" />
          <Button x:Name="ViewFilesButton" x:Uid="ViewFilesButton" Visibility="Collapsed" Margin="0" Click="OnViewFilesClicked" />
          <Button x:Name="DismissReceivedButton" x:Uid="DismissReceivedButton" Visibility="Collapsed" Margin="8,0,0,0" Click="OnDismissReceivedClicked" />
        </StackPanel>
        <Button x:Name="SendButton" x:Uid="SendButton" Visibility="Collapsed" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnSendClicked" />
        <Button x:Name="CancelButton" x:Uid="CancelButton" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCancelClicked" />
        <TextBlock x:Name="StatusText" x:Uid="StartingDiscovery" TextWrapping="Wrap" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
